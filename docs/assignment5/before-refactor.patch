--- a/src/main/java/parking/billing/PricingPolicy.java
+++ b/src/main/java/parking/billing/PricingPolicy.java
@@ -1,12 +1,26 @@
 package parking.billing;
 
+import java.util.Objects;
+import parking.pricing.OccupancySource;
 import parking.store.ParkingException;
 import static parking.store.ParkingException.Reason.INVALID_INPUT;
 
+/** Assignment 5 BEFORE: all tariff variants are coupled to one switch. */
 public final class PricingPolicy {
     public static final int HOURLY_RATE = 500;
+    private final String mode;
+    private final OccupancySource source;
+    public PricingPolicy() { this("hourly", () -> 0.0); }
+    public PricingPolicy(String mode, OccupancySource source) {
+        this.mode = Objects.requireNonNull(mode); this.source = Objects.requireNonNull(source);
+    }
     public int amountFor(int hours) {
         if (hours < 1 || hours > 24) throw new ParkingException(INVALID_INPUT, "Parking duration must be 1-24 whole hours");
-        return hours * HOURLY_RATE;
+        return switch (mode) {
+            case "hourly" -> hours * HOURLY_RATE;
+            case "capped" -> Math.min(hours * HOURLY_RATE, 3000);
+            case "demand" -> hours * HOURLY_RATE + (int) Math.ceil(source.occupancy() * 250) * Math.max(0, hours - 2);
+            default -> throw new IllegalArgumentException("Unknown pricing mode: " + mode);
+        };
     }
 }
